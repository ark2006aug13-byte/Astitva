# Server Config
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Database
DATABASE_URL="file:./dev.db"

# JWT and Session Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_characters
GUEST_SESSION_SECRET=your_guest_session_secret_here_min_32_characters
OTP_HMAC_SECRET=your_otp_hmac_secret_here_min_32_characters

# AES-256-GCM Vault Key (32 bytes / 64 hex characters)
VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Storage Directory for Resumes
RESUME_STORAGE_DIR=./uploads/resumes
